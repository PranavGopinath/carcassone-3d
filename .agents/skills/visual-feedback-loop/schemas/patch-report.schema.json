{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PatchReport",
  "type": "object",
  "required": ["addressed", "summary"],
  "properties": {
    "summary": { "type": "string", "description": "<=40 words: what changed this iteration" },
    "addressed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["defectId", "files", "change", "verified"],
        "properties": {
          "defectId": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "change": { "type": "string", "description": "<=25 words" },
          "verified": { "enum": ["regression-test", "preview", "both", "unverified"] },
          "tests": { "type": "array", "items": { "type": "string" }, "description": "New regression test files" }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["defectId", "reason"],
        "properties": {
          "defectId": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
