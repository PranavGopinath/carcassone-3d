{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PatchSet",
  "type": "object",
  "required": ["patches"],
  "properties": {
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["defectId", "path", "search", "replace", "rationale"],
        "properties": {
          "defectId": { "type": "string" },
          "path": { "type": "string", "description": "Repo-relative, inside patchAllowlist" },
          "search": { "type": "string", "description": "Exact text incl. >=3 lines of context; must occur exactly once" },
          "replace": { "type": "string" },
          "rationale": { "type": "string", "description": "<=25 words" }
        }
      }
    }
  }
}
